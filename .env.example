# Fantasy Football Multi-Division Configuration

# Multiple League IDs (comma-separated)
# Replace with your actual ESPN Fantasy Football League IDs
LEAGUE_IDS=123456789,987654321,555444333

# ESPN Credentials (required for private leagues only)
# Get these from your browser cookies when logged into ESPN
# ESPN_SWID=your_swid_cookie_here
# ESPN_S2=your_s2_cookie_here

# AI Summary (optional, ff-tracker only)
# Off by default. A key alone does not enable it: AI_SUMMARY_ENABLED must be true.
# Team names, owner names and scores are sent to the provider at AI_SUMMARY_BASE_URL,
# and AI_SUMMARY_USER_PROMPT is sent verbatim.
# The API key is never printed; -vv logs the system prompt, so never use -vv in CI.
# AI_SUMMARY_MAX_TOKENS is the request's max_tokens (default 8000).
# AI_SUMMARY_REASONING_EFFORT (low|medium|high) is omitted entirely when unset.
# AI_SUMMARY_ENABLED=true
# AI_SUMMARY_API_KEY=your_opencode_api_key_here
# AI_SUMMARY_BASE_URL=https://opencode.ai/inference/openai/v1
# AI_SUMMARY_MODEL=deepseek-v4.1-flash
# AI_SUMMARY_TIMEOUT=120
# AI_SUMMARY_MAX_TOKENS=8000
# AI_SUMMARY_REASONING_EFFORT=low
# AI_SUMMARY_MAX_PROMPT_CHARS=8000
# AI_SUMMARY_USER_PROMPT="Tone: dry, no emoji. Never mention the commissioner's team."
